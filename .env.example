# Copy to .env or set these in your deployment environment.
MAXFLOW_HOST=127.0.0.1
MAXFLOW_PORT=5210
# Required for a non-loopback bind. Username is maxflow.
MAXFLOW_ACCESS_PASSWORD=
MAXFLOW_API_BASE_URL=
MAXFLOW_API_KEY=
# Optional name of an already exported environment variable containing the key.
MAXFLOW_API_KEY_ENV=
MAXFLOW_TEXT_MODEL=
MAXFLOW_IMAGE_MODEL=
MAXFLOW_IMAGE_TRANSPARENT_BACKGROUND=0
MAXFLOW_VIDEO_MODEL=
# Optional separate compatible video upstream, including its version prefix.
MAXFLOW_VIDEO_API_BASE_URL=
MAXFLOW_VIDEO_API_KEY=
MAXFLOW_VIDEO_API_KEY_ENV=
